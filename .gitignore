*.bin
*.h5

# Audio/media samples
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.aac

###############################
# Python ignores              #
###############################

# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
.env/

# Packaging
build/
dist/
*.egg-info/
*.egg

# Jupyter
.ipynb_checkpoints/

# OS/editor
.DS_Store
._*
*.swp
*.swo
.idea/
.vscode/

# Misc
.pytest_cache/
coverage.xml
.coverage*
